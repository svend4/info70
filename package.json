{
  "name": "info70-kinder-netz-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo prototypes for child-safe digital apps inspired by Germany's post-Ein-Netz-fuer-Kinder landscape.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "validate": "node scripts/validate-monorepo.mjs",
    "start:safe-search": "node apps/safe-search/server.mjs",
    "start:media-time": "node apps/media-time/server.mjs",
    "start:help-bridge": "node apps/help-bridge/server.mjs",
    "start:ai-literacy": "node apps/ai-literacy/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run validate"
  },
  "engines": {
    "node": ">=18"
  }
}
